# Local development: clearly labeled demo workspace backed by SQLite.
AUTH_MODE=demo
DATABASE_URL=sqlite:///./backend/data/contractguard.db

# Optional managed Webdev MySQL-compatible database (provided by the host at runtime).
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional external PostgreSQL database.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/contractguard

# Hosted Manus OAuth values are supplied by the platform; never paste secrets here.
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_PORTAL_URL=
# MANUS_OAUTH_API_URL=

# Set exact comma-separated HTTPS origins for published sites (no paths or trailing slashes).
# The default allowlist includes the initialized Preview origin and localhost only.
# CONTRACTGUARD_ALLOWED_ORIGINS=https://contracts.example.com,https://admin.example.com
